<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#2563EB"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:text="SmartHelp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/userNameText"
            android:text="Welcome User"
            android:textSize="14sp"
            android:textColor="#E5E7EB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">

            <!-- STATUS CARD (UPDATED THEME) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#EFF6FF">

                <LinearLayout
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Status"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1D4ED8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/statusText"
                        android:text="Ready to help 🚀"
                        android:textSize="14sp"
                        android:textColor="#2563EB"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- SOS CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                card_view:cardCornerRadius="20dp"
                card_view:cardElevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFE5E5">

                    <Button
                        android:id="@+id/sosButton"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:text="SOS"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#EF4444"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- QUICK ACTIONS -->
            <TextView
                android:text="Quick Actions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/callBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:text="📞 Call"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/contactsBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:layout_marginStart="10dp"
                    android:text="📇 Contacts"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/mapBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:text="🗺 Map"
                    android:backgroundTint="#F59E0B"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/profileBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:layout_marginStart="10dp"
                    android:text="👤 Profile"
                    android:backgroundTint="#6366F1"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- HOW IT WORKS CARD (UPDATED THEME) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardCornerRadius="16dp"
                card_view:cardElevation="6dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#EFF6FF">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="How it works"
                        android:textStyle="bold"
                        android:textColor="#1D4ED8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="• Press SOS in emergency\n• Location is shared automatically\n• Contacts get alert instantly"
                        android:textColor="#2563EB"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>