<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_bg">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Nearby Helpers"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@color/primary_color"
        android:textColor="@android:color/white"/>

    <!-- 🔥 Category Buttons (SCROLLABLE FIXED) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="All"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnHospital"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Hospital"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnMechanic"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Mechanic"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnElectric"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Electric"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnPlumber"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Plumber"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnPolice"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Police"
                android:layout_margin="4dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Map -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 📍 Share Location Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        card_view:cardCornerRadius="10dp"
        card_view:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share Your Location"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/primary_color" />

            <Button
                android:id="@+id/shareLocationBtn"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="📍 Share Location"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:backgroundTint="@android:color/holo_green_dark"
                android:textColor="@android:color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/primary_color"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/homeBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Home"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/contactsBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Contacts"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/mapBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Location"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>